# Runtime.
DISCORD_BOT_ENVIRONMENT=development
DISCORD_BOT_HOST=127.0.0.1
DISCORD_BOT_PORT=3100
DISCORD_BOT_LOG_LEVEL=info
DISCORD_BOT_LOG_FORMAT=console

# Discord bot. Security also requires Manage Roles, Manage Channels,
# Ban Members and Read Message History; no privileged intent is used.
DISCORD_BOT_TOKEN=
DISCORD_BOT_GUILD_ID=

# Bearer credential for private /api routes.
DISCORD_BOT_API_KEY=
DISCORD_BOT_HTTP_BODY_LIMIT=1048576

# Verification: create the managed message through the API before enabling.
DISCORD_BOT_VERIFICATION_ENABLED=false
DISCORD_BOT_VERIFICATION_CHANNEL_ID=
DISCORD_BOT_VERIFICATION_MESSAGE_KEY=verification
DISCORD_BOT_VERIFICATION_ROLE_ID=

# Anti-bot trap: posting in no-escribir causes an automatic ban.
DISCORD_BOT_ANTIBOT_ENABLED=false
DISCORD_BOT_SECURITY_REFRESH_INTERVAL=1m

# Agreement companies are created through /api/companies.
DISCORD_BOT_AGREEMENTS_ENABLED=false
DISCORD_BOT_AGREEMENTS_CONTROL_CHANNEL_ID=
DISCORD_BOT_AGREEMENTS_CHANNEL_ID=
DISCORD_BOT_AGREEMENTS_REFRESH_INTERVAL=6h

# PostgreSQL.
DISCORD_BOT_POSTGRES_HOST=127.0.0.1
DISCORD_BOT_POSTGRES_PORT=5432
DISCORD_BOT_POSTGRES_DATABASE=discord_bot
DISCORD_BOT_POSTGRES_USER=discord_bot
DISCORD_BOT_POSTGRES_PASSWORD=discord_bot
DISCORD_BOT_POSTGRES_SSL_MODE=disable
DISCORD_BOT_POSTGRES_MAX_CONNS=10
DISCORD_BOT_POSTGRES_MIN_CONNS=0
DISCORD_BOT_POSTGRES_CONNECT_TIMEOUT=5s
DISCORD_BOT_POSTGRES_STATEMENT_TIMEOUT=5s
DISCORD_BOT_POSTGRES_HEALTH_TIMEOUT=2s
