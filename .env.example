# Application: development, test, or production.
DISCORD_BOT_ENVIRONMENT=development
DISCORD_BOT_HOST=127.0.0.1
DISCORD_BOT_PORT=3100
DISCORD_BOT_LOG_LEVEL=info
DISCORD_BOT_LOG_FORMAT=console

# Required Discord bot credential.
DISCORD_BOT_TOKEN=
DISCORD_BOT_GUILD_ID=
DISCORD_BOT_LOCALES_PATH=

# Required bearer credential for private /api routes.
DISCORD_BOT_API_KEY=
DISCORD_BOT_HTTP_BODY_LIMIT=1048576

# Optional Discord identity linking and login. Register the callback URL shown below
# in the Discord Developer Portal. Completion URLs are an allowlist, never caller input.
DISCORD_BOT_OAUTH_ENABLED=false
DISCORD_BOT_OAUTH_CLIENT_ID=
DISCORD_BOT_OAUTH_CLIENT_SECRET=
DISCORD_BOT_OAUTH_PUBLIC_URL=http://localhost:3100
DISCORD_BOT_OAUTH_COMPLETION_URLS={"pixelados-links":"http://localhost:3000/configuracion/vinculos/discord/resultado","pixelados-login":"http://localhost:3000/auth/discord/resultado"}
DISCORD_BOT_OAUTH_HTTP_TIMEOUT=10s
DISCORD_BOT_OAUTH_INTENT_TTL=10m
DISCORD_BOT_OAUTH_RESULT_TTL=5m
DISCORD_BOT_OAUTH_ARTIFACT_RETENTION=168h

# Redis.
DISCORD_BOT_REDIS_ADDR=127.0.0.1:6379
DISCORD_BOT_REDIS_USERNAME=
DISCORD_BOT_REDIS_PASSWORD=
DISCORD_BOT_REDIS_DB=0
DISCORD_BOT_REDIS_DIAL_TIMEOUT=5s
DISCORD_BOT_REDIS_HEALTH_TIMEOUT=2s

# PostgreSQL.
DISCORD_BOT_POSTGRES_HOST=127.0.0.1
DISCORD_BOT_POSTGRES_PORT=5432
DISCORD_BOT_POSTGRES_DATABASE=discord_bot
DISCORD_BOT_POSTGRES_USER=discord_bot
DISCORD_BOT_POSTGRES_PASSWORD=discord_bot
DISCORD_BOT_POSTGRES_SSL_MODE=disable
DISCORD_BOT_POSTGRES_MAX_CONNS=10
DISCORD_BOT_POSTGRES_MIN_CONNS=0
DISCORD_BOT_POSTGRES_CONNECT_TIMEOUT=5s
DISCORD_BOT_POSTGRES_STATEMENT_TIMEOUT=5s
DISCORD_BOT_POSTGRES_HEALTH_TIMEOUT=2s
