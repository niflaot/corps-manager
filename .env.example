# Runtime.
DISCORD_BOT_ENVIRONMENT=development
DISCORD_BOT_HOST=127.0.0.1
DISCORD_BOT_PORT=3100
DISCORD_BOT_LOG_LEVEL=info
DISCORD_BOT_LOG_FORMAT=console

# Discord bot. It only needs View Channel, Send Messages and Manage Messages
# in the configured dashboard channel; no privileged member intent is used.
DISCORD_BOT_TOKEN=
DISCORD_BOT_GUILD_ID=

# Bearer credential for private /api routes.
DISCORD_BOT_API_KEY=
DISCORD_BOT_HTTP_BODY_LIMIT=1048576

# SARP business performance dashboard.
DISCORD_BOT_PERFORMANCE_ENABLED=true
DISCORD_BOT_PERFORMANCE_ENDPOINT=https://flare.niflaot.dev/api/query
# Optional credential for the tunnel/reverse proxy. This is not the SARP API token.
DISCORD_BOT_PERFORMANCE_ENDPOINT_TOKEN=
DISCORD_BOT_PERFORMANCE_BUSINESS_ID=1995
DISCORD_BOT_PERFORMANCE_CHANNEL_ID=
DISCORD_BOT_PERFORMANCE_INTERVAL=6h
DISCORD_BOT_PERFORMANCE_CUTOFF_WEEKDAY=Tuesday
DISCORD_BOT_PERFORMANCE_TIMEZONE=America/Bogota
DISCORD_BOT_PERFORMANCE_HTTP_TIMEOUT=30s
DISCORD_BOT_PERFORMANCE_MAX_RESPONSE_BYTES=2097152
DISCORD_BOT_PERFORMANCE_HISTORY_LIMIT=104

# Durable inactivity-dismissal registry and interactive Discord message.
DISCORD_BOT_INACTIVITY_ENABLED=true
DISCORD_BOT_INACTIVITY_REFRESH_INTERVAL=6h
# Internal channel containing the separate opening-control button.
DISCORD_BOT_ANNOUNCEMENT_CONTROL_CHANNEL_ID=
# Channel that receives @everyone opening announcements.
DISCORD_BOT_ANNOUNCEMENT_CHANNEL_ID=
# Minimum wait between opening announcements. Stored durably in PostgreSQL.
DISCORD_BOT_ANNOUNCEMENT_COOLDOWN=30m

# PostgreSQL.
DISCORD_BOT_POSTGRES_HOST=127.0.0.1
DISCORD_BOT_POSTGRES_PORT=5432
DISCORD_BOT_POSTGRES_DATABASE=discord_bot
DISCORD_BOT_POSTGRES_USER=discord_bot
DISCORD_BOT_POSTGRES_PASSWORD=discord_bot
DISCORD_BOT_POSTGRES_SSL_MODE=disable
DISCORD_BOT_POSTGRES_MAX_CONNS=10
DISCORD_BOT_POSTGRES_MIN_CONNS=0
DISCORD_BOT_POSTGRES_CONNECT_TIMEOUT=5s
DISCORD_BOT_POSTGRES_STATEMENT_TIMEOUT=5s
DISCORD_BOT_POSTGRES_HEALTH_TIMEOUT=2s
